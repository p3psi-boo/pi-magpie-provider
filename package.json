{
  "name": "pi-magpie-provider",
  "version": "0.1.0",
  "description": "Pi provider package for a magpie gateway, discovering models from GET /v1/models.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "magpie",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xRichardH/pi-cliproxyapi-provider.git"
  },
  "bugs": {
    "url": "https://github.com/0xRichardH/pi-cliproxyapi-provider/issues"
  },
  "homepage": "https://github.com/0xRichardH/pi-cliproxyapi-provider#readme",
  "files": [
    "src",
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": ">=0.84.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "typescript": "^5.9.3"
  }
}
